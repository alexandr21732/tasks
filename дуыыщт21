                break
            elif choice == 1:
                print('Количество проданных блюд:')
                if not stats["sales_count"]:
                    print("Продаж пока не было.")
                for item, count in stats["sales_count"].items():
                    print(f"• {item}: {count} шт.")
            elif choice == 2:
                print('История заказов:')
                print(f"Общая выручка: {stats['total_revenue']} руб.")
                if not stats["orders_history"]:
                    print("История заказов пуста.")
                for order in stats["orders_history"]:
                    print(f"Заказ №{order['order_id']}: {', '.join(order['items'])} — {order['total_price']} руб.")
            elif choice == 3:
                print('Остатки на складе:')
                current_stock = load_ingredients()
                for ing, info in current_stock.items():
                    print(f"• {ing}: {info['количество']} шт. ({info['category']})")
            elif choice == 4:
                current_stock = load_ingredients()
                ing_list = list(current_stock.keys())
                print('Выберите ингредиент для пополнения:')
                for idx, ing in enumerate(ing_list, 1):
                    print(f"{idx}. {ing} (сейчас на складе: {current_stock[ing]['количество']} шт.)")
                print("0. Отмена")

                ing_choice = int(input('Номер ингредиента: '))
                if ing_choice == 0:
                    continue
                if 1 <= ing_choice <= len(ing_list):
                    selected_ing = ing_list[ing_choice - 1]
                    add_qty = int(input(f'Сколько штук «{selected_ing}» добавить? '))
                    if add_qty > 0:
                        current_stock[selected_ing]['количество'] += add_qty
                        save_ingredients(current_stock)
                        print(
                            f"Склад обновлен! Теперь «{selected_ing}»: {current_stock[selected_ing]['количество']} шт.")
                    else:
                        print('Количество должно быть больше нуля.')
                else:
                    print('Неверный номер ингредиента.')
            else:
                print('Неверный пункт меню.')
        except ValueError:
            print('Ошибка: введите корректное число.')


def main():
    print('Добро пожаловать в Пиццерию!')
    while True:
        ingredients_stock = load_ingredients()
        stats = load_stats()
        user_input = input('\nСколько вас человек? (exit — выход): ').strip()
        if user_input.lower() == 'exit':
            print('Работа программы завершена. До свидания!')
            break
        if user_input.lower() == 'admin':
            admin_panel()
            continue
        try:
            guests_count = int(user_input)
            if guests_count <= 0:
                print('Количество гостей должно быть больше 0.')
                continue
            elif guests_count > 100:
                print('Мы не можем обсулиживать более 100 гостей')
                continue
        except ValueError:
            print('Пожалуйста, введите число или команду exit.')
            continue
        order_list = []
        total_price = 0
        for i in range(1, guests_count + 1):
            while True:
                try:
                    age = int(input(f'\nГость {i}. Сколько вам лет? '))
                    category = get_age_category(age)
                    break
                except ValueError as e:
                    print(f'Ошибка: {e} Попробуйте снова.')
            print(f'Отлично! Для вас доступно {category}:')
            current_menu = menu[category]
            menu_items = list(current_menu.keys())
            for idx, (item, price) in enumerate(current_menu.items(), 1):
                print(f'{idx}. {item} — {price} руб.')
            while True:
                try:
                    choice = int(input('Выберите номер блюда для Гостя (0 — пропустить): '))
                    if choice == 0:
                        print('Гость решил ничего не заказывать.')
                        break
                    elif 1 <= choice <= len(menu_items):
                        selected_dish = menu_items[choice - 1]
                        if reserve_ingredients(selected_dish, ingredients_stock):
                            dish_price = current_menu[selected_dish]
                            order_list.append(selected_dish)
                            total_price += dish_price
                            print(f'Блюдо «{selected_dish}» ({dish_price} руб.) добавлено в заказ!')
                            break
                        else:
                            print('Пожалуйста, выберите другое блюдо.')
                    else:
                        print('Неверный номер блюда. Попробуйте снова.')
                except ValueError:
                    print('Ошибка: введите число.')
        if order_list:
            save_ingredients(ingredients_stock)
            log_order(order_list, total_price, stats)
            print('Спасибо за заказ! Приятного аппетита!')
        else:
            print('Заказ пуст. Ждем вас снова!')


main()
