def hash_password(password, salt=None):
    if salt is None:
        salt = os.urandom(16).hex()
    pwd_hash = hashlib.pbkdf2_hmac(
        'sha256',
        password.encode('utf-8'),
        bytes.fromhex(salt),
        100000
    ).hex()
    return salt, pwd_hash


def setup_or_load_auth(auth_file="admin_auth.json"):
    if os.path.exists(auth_file):
        try:
            with open(auth_file, "r", encoding="utf-8") as file:
                data = json.load(file)
                if "salt" in data and "hash" in data:
                    return data
        except (json.JSONDecodeError, IOError):
            pass
    print('\n[Настройка безопасности] Файл паролей не найден или поврежден.')
    while True:
        new_pwd = input('Придумайте новый пароль администратора (минимум 4 символа): ').strip()
        if len(new_pwd) >= 4:
            salt, pwd_hash = hash_password(new_pwd)
            auth_data = {"salt": salt, "hash": pwd_hash}
            with open(auth_file, "w", encoding="utf-8") as file:
                json.dump(auth_data, file, indent=4)
            print(f'Пароль зашифрован и сохранен в файл {auth_file}.\n')
            return auth_data
        print('Пароль слишком короткий. Попробуйте снова.')


def require_password(auth_file="admin_auth.json"):
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            auth_data = setup_or_load_auth(auth_file)
            entered_pwd = input('Введите пароль администратора: ').strip()
            _, entered_hash = hash_password(entered_pwd, auth_data["salt"])
            if hmac.compare_digest(entered_hash, auth_data["hash"]):
                return func(*args, **kwargs)
            else:
                print('Ошибка доступа: Неверный пароль!')
                return None
        return wrapper
    return decorator


def validate_age(min_age=1, max_age=119):
    def decorator(func):
        @wraps(func)
        def wrapper(age, *args, **kwargs):
            if not isinstance(age, int) or isinstance(age, bool) or not (min_age <= age <= max_age):
                raise ValueError(f'Возраст должен быть от {min_age} до {max_age} лет.')
            return func(age, *args, **kwargs)
        return wrapper
    return decorator


