rows, colms = 5, 5
n = rows

matrix = []
for i in range(rows):
    row = []
    for j in range(colms):
        if i + j == n - 1:
            row.append(1)
        elif i + j < n - 1:
            row.append(0)
        else:
            row.append(2)
    matrix.append(row)

for row in matrix:
    for item in row:
        print(item, end=" ")
    print()
