def save_ingredients(ingredients):
    with open("ingredients.json", "w", encoding="utf-8") as file:
        json.dump(ingredients, file, ensure_ascii=False, indent=4)

def check_and_deduct_ingredients(dish_name, ingredients):
    recipe = RECIPES.get(dish_name, {})
    
    for ing, req_qty in recipe.items():
        if ing not in ingredients or ingredients[ing]['количество'] < req_qty:
            print(f"Ошибка: Недостаточно {ing} для приготовления.")
            return False
            
    for ing, req_qty in recipe.items():
        ingredients[ing]['количество'] -= req_qty
        
    save_ingredients(ingredients)
    return True

